{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "slipramp/catalog",
          "rules": [
            {
              "id": "catalog.target.path-not-found"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "catalog.target.path-not-found",
          "level": "warning",
          "message": {
            "text": "target path \"missing\" does not exist in the checkout Hint: The path may be generated later; create it or ignore this warning when that is intentional."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".slipramp/catalog.yaml"
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 9,
                  "endLine": 13,
                  "endColumn": 16
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
