#!/usr/bin/env python3
"""Test double for the infrastructure example's ansible-playbook process."""

import json
import os
from pathlib import Path
import sys
import time


ready = os.environ.get("FAKE_ANSIBLE_READY")
if ready:
    Path(ready).write_text("ready", encoding="utf-8")
    while True:
        time.sleep(60)

with open(os.environ["FAKE_ANSIBLE_RECORD"], "w", encoding="utf-8") as output:
    json.dump(sys.argv[1:], output)
print("ansible stdout")
print("ansible stderr", file=sys.stderr)
sys.exit(int(os.environ["FAKE_ANSIBLE_RC"]))
