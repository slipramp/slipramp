#!/usr/bin/env python3
"""Test double for the product-owned Ansible Runner adapter."""

import json
import os
from pathlib import Path
import signal
import sys
import time


def option(arguments: list[str], name: str) -> str:
    index = arguments.index(name)
    return arguments[index + 1]


def write_artifacts(directory: Path, status: str, exit_code: int, partial: bool) -> None:
    event_directory = directory / "job_events"
    event_directory.mkdir(parents=True, exist_ok=True)

    events = [
        {
            "counter": 1,
            "uuid": "event-1",
            "event": "playbook_on_start",
            "event_data": {"playbook": "site.yml", "playbook_uuid": "playbook-1"},
        },
        {
            "counter": 2,
            "uuid": "event-2",
            "event": "playbook_on_stats",
            "event_data": {
                "processed": {"node01.example.com": 1},
                "ok": {"node01.example.com": 1},
                "changed": {},
                "dark": {},
                "failures": {},
                "skipped": {},
                "rescued": {},
                "ignored": {},
            },
        },
    ]
    if partial:
        events = events[:1]
    for event in reversed(events):
        path = event_directory / f"{event['counter']}-{event['uuid']}.json"
        path.write_text(json.dumps(event), encoding="utf-8")

    (directory / "status").write_text(status, encoding="utf-8")
    (directory / "rc").write_text(str(exit_code), encoding="utf-8")


def main() -> int:
    arguments = sys.argv[1:]
    if arguments == ["--version"]:
        print("2.4.3")
        return 0

    record_path = os.environ.get("FAKE_ANSIBLE_RECORD")
    if record_path:
        Path(record_path).write_text(json.dumps(arguments), encoding="utf-8")

    artifact_directory = Path(option(arguments, "--artifact-dir")) / option(arguments, "--ident")
    configured_exit_code = int(os.environ.get("FAKE_ANSIBLE_RC", "0"))
    configured_status = os.environ.get(
        "FAKE_ANSIBLE_STATUS",
        "successful" if configured_exit_code == 0 else "failed",
    )

    def terminate(_received: int, _frame: object) -> None:
        write_artifacts(artifact_directory, "canceled", 254, partial=True)
        raise SystemExit(254)

    signal.signal(signal.SIGTERM, terminate)
    signal.signal(signal.SIGINT, terminate)

    print("ansible stdout", flush=True)
    print("ansible stderr", file=sys.stderr, flush=True)
    ready_path = os.environ.get("FAKE_ANSIBLE_READY")
    if ready_path:
        Path(ready_path).touch()
        while True:
            time.sleep(0.01)

    write_artifacts(
        artifact_directory,
        configured_status,
        configured_exit_code,
        partial=os.environ.get("FAKE_ANSIBLE_PARTIAL") == "1",
    )
    return configured_exit_code


if __name__ == "__main__":
    raise SystemExit(main())
