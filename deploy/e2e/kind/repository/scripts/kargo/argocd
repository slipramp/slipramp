#!/bin/sh

# Replace the external Argo CD command only; preparation and uploads are real.
set -eu

test "$ARGOCD_AUTH_TOKEN" = acceptance-argo-token
test "$#" -eq 10
test "$1 $2 $3" = 'app diff acceptance'
test "$4" = --revision
test "${#5}" -eq 40
test "$6 $7 $8 $9 ${10}" = \
  '--hard-refresh --exit-code=false --server acceptance-argocd --server-side-diff'

cat <<'EOF'
===== apps/Deployment default/acceptance ======
@@ -1 +1 @@
-image: acceptance:old
+image: acceptance:new
EOF
