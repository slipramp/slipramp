{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["imagePullSecrets", "server", "web", "ingress", "httpRoute"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "$ref": "#/$defs/dnsSubdomain" } }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "image",
        "service",
        "metrics",
        "shutdownTimeout",
        "trustedProxyHops",
        "database",
        "objectStore",
        "controllerEnrollmentTokens",
        "artifactTokenSecret",
        "artifacts",
        "oidc",
        "repositoryRefresh",
        "kargo",
        "notifications",
        "placements",
        "clusters",
        "startupProbe",
        "livenessProbe",
        "readinessProbe",
        "resources",
        "podSecurityContext",
        "securityContext",
        "nodeSelector",
        "affinity",
        "tolerations",
        "topologySpreadConstraints"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "const": 1 },
        "image": { "$ref": "#/$defs/image" },
        "service": { "$ref": "#/$defs/service" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "shutdownTimeout": { "$ref": "#/$defs/duration" },
        "trustedProxyHops": { "type": "integer", "minimum": 0 },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "connectTimeout"],
          "properties": {
            "url": { "$ref": "#/$defs/secretInput" },
            "connectTimeout": { "$ref": "#/$defs/duration" }
          }
        },
        "objectStore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "region",
            "bucket",
            "accessKeyID",
            "secretAccessKey",
            "startupTimeout"
          ],
          "properties": {
            "endpoint": { "type": "string", "pattern": "^https?://[^[:space:]]+$" },
            "region": { "type": "string", "minLength": 1 },
            "bucket": { "type": "string", "minLength": 3, "maxLength": 63 },
            "accessKeyID": { "$ref": "#/$defs/secretInput" },
            "secretAccessKey": { "$ref": "#/$defs/secretInput" },
            "startupTimeout": { "$ref": "#/$defs/duration" }
          }
        },
        "controllerEnrollmentTokens": { "$ref": "#/$defs/secretInput" },
        "artifactTokenSecret": { "$ref": "#/$defs/secretInput" },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retentionPeriod", "reconciliationInterval", "orphanGracePeriod"],
          "properties": {
            "retentionPeriod": { "$ref": "#/$defs/duration" },
            "reconciliationInterval": { "$ref": "#/$defs/duration" },
            "orphanGracePeriod": { "$ref": "#/$defs/duration" }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "clientID",
            "clientSecret",
            "redirectURL",
            "subjectRoles",
            "sessionLifetime"
          ],
          "properties": {
            "issuer": { "type": "string", "pattern": "^https?://[^[:space:]]+$" },
            "clientID": { "type": "string", "minLength": 1 },
            "clientSecret": { "$ref": "#/$defs/secretInput" },
            "redirectURL": {
              "type": "string",
              "pattern": "^https?://[^[:space:]]+/api/v1/auth/callback$"
            },
            "subjectRoles": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "minLength": 1 },
              "additionalProperties": {
                "type": "string",
                "enum": ["admin", "operator", "viewer"]
              }
            },
            "sessionLifetime": { "$ref": "#/$defs/duration" }
          }
        },
        "repositoryRefresh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interval", "fetchTimeout", "credentials"],
          "properties": {
            "interval": { "$ref": "#/$defs/duration" },
            "fetchTimeout": { "$ref": "#/$defs/duration" },
            "credentials": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/dnsLabel" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["secretName", "gitConfigKey"],
                "properties": {
                  "secretName": { "$ref": "#/$defs/dnsSubdomain" },
                  "gitConfigKey": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][-._A-Za-z0-9]*$"
                  }
                }
              }
            }
          }
        },
        "kargo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrations"],
          "properties": {
            "integrations": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/dnsLabel" },
              "additionalProperties": { "$ref": "#/$defs/kargoIntegration" }
            }
          }
        },
        "notifications": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicUrl", "destinations", "routes", "retry", "retentionPeriod"],
          "properties": {
            "publicUrl": { "type": "string" },
            "destinations": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/dnsLabel" },
              "additionalProperties": { "$ref": "#/$defs/notificationDestination" }
            },
            "routes": {
              "type": "array",
              "items": { "$ref": "#/$defs/notificationRoute" }
            },
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maximumAttempts", "maximumBackoff"],
              "properties": {
                "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
                "maximumBackoff": { "$ref": "#/$defs/duration" }
              }
            },
            "retentionPeriod": { "$ref": "#/$defs/duration" }
          },
          "allOf": [
            {
              "if": { "properties": { "destinations": { "minProperties": 1 } } },
              "then": {
                "properties": {
                  "publicUrl": { "pattern": "^https?://[^[:space:]?#]+(?:/[^[:space:]?#]*)?$" },
                  "routes": { "minItems": 1 }
                }
              },
              "else": {
                "properties": {
                  "publicUrl": { "maxLength": 0 },
                  "routes": { "maxItems": 0 }
                }
              }
            }
          ]
        },
        "placements": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/dnsLabel" },
          "additionalProperties": { "$ref": "#/$defs/placement" }
        },
        "clusters": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/dnsLabel" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maximumActiveRuns"],
            "properties": {
              "maximumActiveRuns": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "startupProbe": { "$ref": "#/$defs/probe" },
        "livenessProbe": { "$ref": "#/$defs/probe" },
        "readinessProbe": {
          "allOf": [
            { "$ref": "#/$defs/probe" },
            {
              "type": "object",
              "properties": { "timeoutSeconds": { "type": "integer", "minimum": 3 } }
            }
          ]
        },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "nodeSelector": { "$ref": "#/$defs/stringMap" },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "image",
        "trustedProxyHops",
        "service",
        "resources",
        "startupProbe",
        "livenessProbe",
        "readinessProbe",
        "podSecurityContext",
        "securityContext",
        "nodeSelector",
        "affinity",
        "tolerations",
        "topologySpreadConstraints"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "const": 1 },
        "image": { "$ref": "#/$defs/image" },
        "trustedProxyHops": { "type": "integer", "minimum": 0 },
        "service": { "$ref": "#/$defs/service" },
        "resources": { "type": "object" },
        "startupProbe": { "$ref": "#/$defs/probe" },
        "livenessProbe": { "$ref": "#/$defs/probe" },
        "readinessProbe": { "$ref": "#/$defs/probe" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "nodeSelector": { "$ref": "#/$defs/stringMap" },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "host", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/$defs/stringMap" },
        "host": { "type": "string" },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hosts", "secretName"],
            "properties": {
              "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "secretName": { "$ref": "#/$defs/dnsSubdomain" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "host": { "minLength": 1 } } }
        }
      ]
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "annotations", "parentRefs", "hostnames"],
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "$ref": "#/$defs/stringMap" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "group": { "type": "string", "maxLength": 253 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 63 },
              "namespace": { "$ref": "#/$defs/dnsLabel" },
              "name": { "$ref": "#/$defs/dnsSubdomain" },
              "sectionName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "hostnames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hostname" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "properties": {
              "parentRefs": { "minItems": 1 },
              "hostnames": { "minItems": 1 }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[^[:space:]]+$" },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "digest": {
          "type": "string",
          "oneOf": [
            { "maxLength": 0 },
            { "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "$ref": "#/$defs/stringMap" }
      }
    },
    "secretInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "existingSecret"],
      "properties": {
        "value": { "type": "string" },
        "existingSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "value": { "minLength": 1 },
            "existingSecret": {
              "properties": {
                "name": { "maxLength": 0 },
                "key": { "maxLength": 0 }
              }
            }
          }
        },
        {
          "properties": {
            "value": { "maxLength": 0 },
            "existingSecret": {
              "properties": {
                "name": { "$ref": "#/$defs/dnsSubdomain" },
                "key": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "jobNamespace"],
      "properties": {
        "cluster": { "$ref": "#/$defs/dnsLabel" },
        "jobNamespace": { "$ref": "#/$defs/dnsLabel" },
        "maximumActiveRuns": { "type": "integer", "minimum": 1 },
        "serviceAccountName": { "$ref": "#/$defs/dnsSubdomain" },
        "timeout": { "$ref": "#/$defs/duration" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": { "$ref": "#/$defs/stringMap" },
            "limits": { "$ref": "#/$defs/stringMap" }
          }
        },
        "nodeSelector": { "$ref": "#/$defs/stringMap" },
        "credentials": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/dnsLabel" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretRef"],
            "properties": {
              "secretRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": { "name": { "$ref": "#/$defs/dnsSubdomain" } }
              }
            }
          }
        },
        "podTemplate": { "type": "object" }
      }
    },
    "kargoIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "repositories",
        "environmentOrder",
        "preparation",
        "maximumStageObservationAge",
        "pendingReviewRetention"
      ],
      "properties": {
        "cluster": { "$ref": "#/$defs/dnsLabel" },
        "uiUrl": { "type": "string", "format": "uri" },
        "argoCdUiUrls": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 200 },
          "additionalProperties": { "type": "string", "format": "uri" }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dnsLabel" }
        },
        "environmentOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "target", "action"],
          "properties": {
            "repository": { "$ref": "#/$defs/dnsLabel" },
            "target": { "$ref": "#/$defs/dnsLabel" },
            "action": { "$ref": "#/$defs/dnsLabel" }
          }
        },
        "candidateBranchCleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retention", "credentials"],
          "properties": {
            "retention": { "$ref": "#/$defs/duration" },
            "credentials": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/dnsLabel" },
              "additionalProperties": { "$ref": "#/$defs/dnsLabel" }
            }
          }
        },
        "maximumStageObservationAge": { "$ref": "#/$defs/duration" },
        "pendingReviewRetention": { "$ref": "#/$defs/duration" }
      }
    },
    "notificationDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "secretName", "secretKey"],
      "properties": {
        "type": { "type": "string", "enum": ["slack"] },
        "secretName": { "$ref": "#/$defs/dnsSubdomain" },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][-._A-Za-z0-9]*$"
        }
      }
    },
    "notificationRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "destinations"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["review.requested"] }
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dnsLabel" }
        }
      }
    }
  }
}
