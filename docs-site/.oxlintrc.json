{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [".astro/**", "dist/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"]
}
