{
  "name": "@slipramp/docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro sync && tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
