{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slipramp-site",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  // slipramp.com is attached to this Worker once in Cloudflare. Routine asset
  // deployments must not require permission to rewrite zone routes.
}
