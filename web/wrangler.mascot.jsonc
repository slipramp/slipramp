{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slipramp-mascot",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/mascot",
    "not_found_handling": "single-page-application",
  },
  // mascot.slipramp.com is attached to this Worker once in Cloudflare. Routine
  // asset deployments must not require permission to rewrite zone routes.
}
